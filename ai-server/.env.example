# LLM（二选一，至少填一个 API Key）
# 直连 DeepSeek 官方
DEEPSEEK_API_KEY=your_deepseek_api_key
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# 或通过 OpenAI 兼容代理（如 openai-proxy）
# CLOSEAI_API_KEY=your_proxy_api_key
# CLOSEAI_BASE_URL=https://api.openai-proxy.org/v1
# LLM_PROVIDER=closeai

# Redis / MySQL 默认从 docker-compose.yml 读取，也可在此覆盖
# REDIS_URL=redis://:redis@127.0.0.1:6381/1
# MYSQL_HOST=127.0.0.1
# MYSQL_PORT=3309
# MYSQL_USER=root
# MYSQL_PASSWORD=ai-server123
# MYSQL_DATABASE=ai_server

REDIS_TTL_SECONDS=604800

# JWT（可选）
# JWT_SECRET=ai-server-jwt-secret-change-me
# JWT_EXPIRE_MINUTES=60

# 服务监听（可选）
HOST=127.0.0.1
PORT=8000
